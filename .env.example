# Copy to .env (never committed). The database values below are DDEV's defaults, so a fresh
# `ddev start` works as is; every other environment gets its own values at deploy time.
# Full list: https://docs.silverstripe.org/en/6/getting_started/environment_management/
SS_DATABASE_CLASS="MySQLDatabase"
SS_DATABASE_SERVER="db"
SS_DATABASE_USERNAME="db"
SS_DATABASE_PASSWORD="db"
SS_DATABASE_NAME="db"

# "dev" locally; "test" on staging; "live" in production.
SS_ENVIRONMENT_TYPE="dev"
# Locally: the DDEV URL (`ddev describe` prints it). Staging and production: the canonical https host.
SS_BASE_URL=""
# Staging and production: the hosts this site answers to, comma-separated (blocks Host-header abuse).
# SS_ALLOWED_HOSTS="www.firm-domain.ca,firm-domain.ca"

# Caught exceptions are written here, not to the web server log (path relative to the project root).
SS_ERROR_LOG="silverstripe.log"

# Local only. Never set a default admin on staging or production.
SS_DEFAULT_ADMIN_USERNAME="admin"
SS_DEFAULT_ADMIN_PASSWORD="change-me-locally"

# Mail. Locally this is DDEV's Mailpit, which catches everything: read it with `ddev mailpit`.
# Production uses a Mailgun DSN supplied on the server, never committed.
MAILER_DSN="smtp://127.0.0.1:1025"

# Staging MUST NOT email the client. Set this on any environment that has a copy of production content:
# every message goes to this address instead of the recipients on the form.
# SS_SEND_ALL_EMAILS_TO="dave@icona.ca"
# The envelope sender. Use a subdomain that is SPF/DKIM-aligned for the sending service
# (website@mg.<domain>), not the firm's own domain, or intake mail lands in junk.
# SS_SEND_ALL_EMAILS_FROM="website@mg.firm-domain.ca"

# reCAPTCHA v3: a matched pair from ONE registration covering apex, www and staging hosts. Required as
# soon as a form has a spam protection field (the field refuses to render without keys).
SS_NOCAPTCHA_SITE_KEY=""
SS_NOCAPTCHA_SECRET_KEY=""
