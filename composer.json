{
    "name": "icona/ss6-starter",
    "type": "silverstripe-recipe",
    "description": "ICONA SilverStripe 6 site starter: the fleet pattern with no client identity",
    "license": "BSD-3-Clause",
    "require": {
        "php": "^8.4",
        "silverstripe/recipe-plugin": "~2.1.0@stable",
        "silverstripe/vendor-plugin": "~3.0.0@stable",
        "silverstripe/recipe-cms": "~6.2.0@stable",
        "silverstripe/startup-theme": "~1.0.11@stable",
        "silverstripe/login-forms": "~6.2.0@stable",
        "silverstripe/htmleditor-tinymce": "~1.1.0@stable",
        "dnadesign/silverstripe-elemental": "^6.1",
        "silverstripe/userforms": "^7.0",
        "wilr/silverstripe-googlesitemaps": "^4.0",
        "silverstripe/blog": "^5.1",
        "dnadesign/silverstripe-elemental-list": "^3.0",
        "dnadesign/silverstripe-elemental-userforms": "^5.0",
        "bummzack/sortablefile": "^3.0",
        "silverstripe/linkfield": "^5.2",
        "symbiote/silverstripe-gridfieldextensions": "^5.2",
        "symfony/mailgun-mailer": "^8.0",
        "symfony/http-client": "^8.0",
        "syntro/silverstripe-seo": "^6.0",
        "undefinedoffset/silverstripe-nocaptcha": "^3.1",
        "silverstripe/redirectedurls": "^4.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.3",
        "wernerkrauss/silverstripe-rector": "^1.2"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/src/"
        }
    },
    "extra": {
        "project-files-installed": [
            ".htaccess",
            "app/.htaccess",
            "app/_config/mimevalidator.yml",
            "app/_config/mysite.yml",
            "app/src/Page.php",
            "app/src/PageController.php"
        ],
        "public-files-installed": [
            ".htaccess",
            "index.php",
            "web.config"
        ],
        "expose": [
            "themes/app-theme/css/dist",
            "themes/app-theme/images",
            "themes/app-theme/js/dist",
            "themes/app-theme/fonts"
        ]
    },
    "config": {
        "process-timeout": 600,
        "allow-plugins": {
            "composer/installers": true,
            "silverstripe/recipe-plugin": true,
            "silverstripe/vendor-plugin": true
        },
        "platform": {
            "php": "8.4.1"
        }
    },
    "prefer-stable": true,
    "minimum-stability": "dev"
}
